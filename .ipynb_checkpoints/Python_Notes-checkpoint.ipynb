    "#Lambda Function\n",
    "\n",
    "def myfunc(n):\n",
    "    return lambda x: x*n\n",
    "\n",
    "double = myfunc(5)\n",
    "print(double(2))\n",
    "\n",
    "triple = myfunc(6)\n",
    "print(triple(3))\n",
    "\n",
    "print(myfunc(5)(2))"
   ]
  }
